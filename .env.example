# Django General Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL Connection String)
DATABASE_URL=postgresql://user:password@ep-host-name.aws.neon.tech/dbname?sslmode=require

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Clerk Authentication Settings
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# PEM formatted public key or JWKS URI configuration for verifying JWTs locally
CLERK_JWT_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
