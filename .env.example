# Django General Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL Connection String — Aiven for test, Neon for production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Clerk Authentication Settings
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# PEM formatted public key or JWKS URI configuration for verifying JWTs locally
CLERK_JWT_PEM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Webhook signing secret for verifying Clerk webhook payloads (whsec_...)
CLERK_WEBHOOK_SECRET=whsec_...
